{
  "name": "for-your-tickets-mobile",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"app/**/*.{js,jsx,ts,tsx}\" \"components/**/*.{js,jsx,ts,tsx}\" \"constants/**/*.{js,jsx,ts,tsx}\" \"hooks/**/*.{js,jsx,ts,tsx}\" \"services/**/*.{js,jsx,ts,tsx}\" \"stores/**/*.{js,jsx,ts,tsx}\" \"types/**/*.{js,jsx,ts,tsx}\" \"utils/**/*.{js,jsx,ts,tsx}\" \"*.{js,ts}\"",
    "test": "jest --runInBand",
    "format": "prettier \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml}\" --check",
    "check": "yarn typecheck && yarn lint && yarn test && yarn format:check"
  },
