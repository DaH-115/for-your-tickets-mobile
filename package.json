    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.12.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.81.5",
